# Django settings
SECRET_KEY=django-insecure-your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database settings
USE_POSTGRES=False
DB_NAME=myproject_db
